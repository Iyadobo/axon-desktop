  #prompt::placeholder { color:color-mix(in srgb, var(--color-text) 40%, transparent); }
  .composer-foot { display:flex; align-items:center; justify-content:space-between; padding:8px 14px 12px; }
  .select-tag { position:relative; display:inline-flex; align-items:center; }
  #model { appearance:none; -webkit-appearance:none; border:1px solid var(--color-divider);
    border-radius:999px; padding:5px 26px 5px 12px; background:var(--color-bg); color:var(--color-text);
    font:inherit; font-size:12.5px; max-width:220px; cursor:pointer; }
  #model:focus { outline:none; border-color:var(--color-accent); }
  .select-tag::after { content:"▾"; position:absolute; right:10px; pointer-events:none; font-size:11px; opacity:.6; }
  #send { width:32px; height:32px; border-radius:8px; border:none; background:var(--color-accent);
    color:#fff; font-size:15px; cursor:pointer; display:grid; place-items:center; }
  #send:hover { background:var(--color-accent-600); }
  #send.stop { background:var(--color-surface-2); color:var(--color-text); }
  #composerSlot { padding:14px 18px 18px; border-top:1px solid var(--color-divider); background:transparent; }
  .hint { max-width:760px; margin:6px auto 0; font-size:11px; opacity:.4; text-align:center; }

  /* polish: thin scrollbars, transitions, focus rings */
  #scroller, #recents, #cmdlist { scrollbar-width: thin; scrollbar-color: rgba(0,0,0,.18) transparent; }
  ::-webkit-scrollbar { width:10px; height:10px; }
  ::-webkit-scrollbar-thumb { background:rgba(0,0,0,.16); border-radius:6px; border:3px solid transparent; background-clip:content-box; }
  ::-webkit-scrollbar-thumb:hover { background:rgba(0,0,0,.28); background-clip:content-box; }
  ::-webkit-scrollbar-track { background:transparent; }
  .newchat, .recent, .chip, #send { transition:background .12s ease, color .12s ease, border-color .12s ease, transform .08s ease; }
  .chip:active, #send:active { transform:scale(.97); }
  :focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
  #prompt:focus-visible { outline:none; }
  #home h1, #home .sub, .home-hint { animation:fadein .5s ease both; }
  @keyframes fadein { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }

  /* settings + projects modal */
  .modal { position:fixed; inset:0; background:rgba(0,0,0,.32); display:none; align-items:center;
    justify-content:center; z-index:50; backdrop-filter:blur(2px); }
  .modal.show { display:flex; }
  .modal-card { width:min(560px,92vw); max-height:86vh; overflow:auto; background:var(--color-bg);
    border:1px solid var(--color-divider); border-radius:14px; box-shadow:0 18px 50px rgba(0,0,0,.22);
    animation:pop .16s ease; }
  @keyframes pop { from { transform:scale(.97); opacity:0; } to { transform:none; opacity:1; } }
  .modal-head { display:flex; align-items:center; justify-content:space-between; padding:14px 16px;
    border-bottom:1px solid var(--color-divider); position:sticky; top:0; background:var(--color-bg); }
  .modal-head h3 { margin:0; font-size:15px; font-weight:800; }
  .modal-head .x { border:none; background:transparent; font-size:20px; cursor:pointer; color:var(--color-neutral); padding:0 4px; line-height:1; }
  .modal-head .x:hover { color:var(--color-text); }
  .modal-body { padding:16px; display:flex; flex-direction:column; gap:18px; }
  .fld { display:flex; flex-direction:column; gap:6px; font-size:13px; }
  .fld > span { font-weight:700; opacity:.7; }
  .fld textarea, .fld select, .fld input[type=text] { font:inherit; font-size:13px; padding:8px 10px;
    border:1px solid var(--color-divider); border-radius:8px; background:var(--color-bg); color:var(--color-text); }
  .fld textarea { min-height:88px; resize:vertical; line-height:1.45; }
  .row { display:flex; gap:14px; }
  .row .fld { flex:1; }
  .swatches { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .sw { width:24px; height:24px; border-radius:50%; cursor:pointer; border:2px solid transparent; }
  .sw.sel { border-color:var(--color-text); }
  .sw input[type=color] { width:24px; height:24px; padding:0; border:none; background:none; cursor:pointer; border-radius:50%; }
  .proj-row { display:flex; align-items:center; gap:8px; }
  .proj-row input { flex:1; }
  .proj-row button { padding:7px 10px; border:1px solid var(--color-divider); background:var(--color-surface);
    border-radius:8px; cursor:pointer; font:inherit; font-size:12px; }
  .proj-row button:hover { border-color:var(--color-accent); color:var(--color-accent); }
  .proj-list { display:flex; flex-direction:column; gap:6px; }
  .proj-item { display:flex; align-items:center; gap:8px; padding:8px 10px; border:1px solid var(--color-divider);
    border-radius:8px; cursor:pointer; font-size:13px; }
  .proj-item.active { border-color:var(--color-accent); background:color-mix(in srgb, var(--color-accent) 8%, var(--color-bg)); }
  .proj-item .pname { font-weight:600; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .proj-item .ppath { font-size:11px; opacity:.5; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:42%; }
  .proj-item .pdel { opacity:0; border:none; background:transparent; cursor:pointer; color:var(--color-bad); font-size:14px; }
  .proj-item:hover .pdel { opacity:.7; }
  .proj-item .pdel:hover { opacity:1; }

  /* LAN link section */
  .lan-check { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:400; opacity:1; cursor:pointer; }
  .lan-check input { accent-color: var(--color-accent); }
  .lan-info { font-size:11px; opacity:.6; min-height:1em; word-break:break-all; }

  /* attachments (composer) */
  #attachRow { display:flex; gap:6px; flex-wrap:wrap; padding:8px 16px 0; }
  #attachRow:empty { display:none; }
  .atch { display:inline-flex; align-items:center; gap:6px; padding:4px 8px; font-size:12px;
    background:var(--color-surface); border:1px solid var(--color-divider); border-radius:7px; max-width:200px; }
  .atch .nm { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .atch .bin { opacity:.5; font-size:10px; }
  .atch .x { cursor:pointer; opacity:.5; border:none; background:transparent; padding:0; font-size:13px; }
  .atch .x:hover { opacity:1; color:var(--color-bad); }

  /* gear + small composer buttons */
  .iconbtn { border:none; background:transparent; color:var(--color-neutral); cursor:pointer;
    width:30px; height:30px; border-radius:8px; display:grid; place-items:center; }
  .iconbtn:hover { background:var(--color-surface); color:var(--color-text); }
  .composer-foot .left { display:flex; align-items:center; gap:4px; }

  /* markdown prose + code blocks in AI bubbles */
  .turn.ai .bubble { white-space:normal; overflow-wrap:anywhere; }
  .turn.ai .bubble p { margin:0 0 7px; }
  .turn.ai .bubble p:last-child { margin-bottom:0; }
  .turn.ai .bubble h2 { font-size:1.25em; margin:.4em 0 .25em; font-weight:800; }
  .turn.ai .bubble h3 { font-size:1.1em; margin:.35em 0 .2em; font-weight:700; }
  .turn.ai .bubble h4 { font-size:1em; margin:.3em 0 .15em; font-weight:700; }
  .turn.ai .bubble ul, .turn.ai .bubble ol { margin:0 0 7px; padding-left:1.3em; }
  .turn.ai .bubble li { margin:1px 0; }
  .turn.ai .bubble code { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:.9em;
    background:color-mix(in srgb, var(--color-text) 8%, transparent); padding:1px 5px; border-radius:5px; }
  .turn.ai .bubble a { color:var(--color-accent); text-decoration:underline; }
  .turn.ai .bubble strong { font-weight:700; }
  pre.code { margin:0 0 9px; background:color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
    border:1px solid var(--color-divider); border-radius:8px; overflow:auto; }
  pre.code .codebar { display:flex; justify-content:space-between; align-items:center;
    padding:5px 10px; border-bottom:1px solid var(--color-divider); font-size:11px; opacity:.6;
    text-transform:uppercase; letter-spacing:.04em; position:sticky; top:0; }
  pre.code .copycode { border:none; background:transparent; cursor:pointer; font:inherit; font-size:10px;
    opacity:.7; text-transform:none; letter-spacing:0; color:var(--color-accent); }
  pre.code .copycode:hover { opacity:1; }
  pre.code code { display:block; padding:10px 12px; background:none; font-size:12.5px;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; white-space:pre; }

  /* per-turn model label + copy button */
  .turnhead { font-size:11px; color:var(--color-neutral); margin:0 0 3px; opacity:.7;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
  .turn.ai { position:relative; }
  .copymsg { position:absolute; top:0; right:0; border:1px solid var(--color-divider); background:var(--color-bg);
    color:var(--color-neutral); font-size:10px; padding:2px 7px; border-radius:6px; cursor:pointer; opacity:0; transition:opacity .12s; }
  .turn.ai:hover .copymsg { opacity:.85; }
  .copymsg:hover { color:var(--color-accent); border-color:var(--color-accent); opacity:1; }

  /* delete-on-hover for recents */
  .recent { position:relative; padding-right:24px; }
  .rdel { position:absolute; right:6px; top:50%; transform:translateY(-50%); opacity:0;
    font-size:11px; color:var(--color-bad); cursor:pointer; }
  .recent:hover .rdel { opacity:.6; }
  .rdel:hover { opacity:1; }
</style>
</head>
<body>
<canvas id="grid"></canvas>
<div id="app">
  <div id="side">
    <div class="brand"><img class="logo" src="../assets/icon.png" alt="Axion" /><span style="flex:1">Axion</span><button class="iconbtn" id="settingsBtn" title="Settings" aria-label="Settings" style="width:26px;height:26px"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 13a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1 1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z"/></svg></button></div>
    <div class="newchat" id="newchat"><span style="opacity:.6">+</span><span>New chat</span></div>
    <div class="recents-label" id="recents-label">Recents</div>
    <div id="recents"></div>
    <div class="sidefoot">
      <span id="backend">Ollama 11434</span>
      <span style="display:flex;align-items:center"><span id="statustext">starting</span><span class="dot" id="dot"></span></span>
    </div>
  </div>

  <div id="main">
    <div class="titlebar"><div class="tl"><span></span><span></span><span></span></div></div>

    <!-- home (empty) -->
    <div id="home">
      <div class="wrap">
        <h1 id="greet">Good afternoon.</h1>
        <p class="sub">What are we working on?</p>
        <div id="composerCard" class="card">
          <div id="cmdlist"></div>
          <div id="attachRow"></div>
          <textarea id="prompt" placeholder="Message Axion…  (Enter to send, Shift+Enter for newline; /help for commands)" rows="1"></textarea>
          <div class="composer-foot">
            <span class="left">
              <button class="iconbtn" id="attachBtn" title="Attach files" aria-label="Attach files"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5 12.5 20a5 5 0 0 1-7-7l8.5-8.5a3.5 3.5 0 0 1 5 5L10.5 19a2 2 0 0 1-3-3l8-8"/></svg></button>
              <input type="file" id="fileInput" multiple style="display:none" />
              <span class="select-tag"><select id="model"></select></span>
            </span>
            <button id="send" title="Send">→</button>
          </div>
        </div>
        <div class="chips" id="chips">
          <span class="chip">Explain code</span>
          <span class="chip">Debug an error</span>
          <span class="chip">Write docs</span>
          <span class="chip">Brainstorm</span>
        </div>
        <p class="home-hint">Type <code>/help</code> for commands · custom commands from <code>~/.claude/commands</code> are expanded locally · routed to your selected Ollama model · tools (Read · Write · Edit · Bash · WebFetch) run automatically</p>
      </div>
    </div>

    <!-- chat -->
    <div id="chat">
      <div id="scroller"><div id="log"></div></div>
      <div id="composerSlot"></div>
    </div>
  </div>
</div>

<!-- settings modal -->
<div class="modal" id="settings">
  <div class="modal-card">
    <div class="modal-head"><h3>Settings</h3><button class="x" id="settingsClose">×</button></div>
    <div class="modal-body">
      <label class="fld"><span>System prompt</span>
        <textarea id="sysPrompt" placeholder="Appended to every request via --append-system-prompt. Shapes the agent's behavior, tone, constraints…"></textarea>
      </label>
      <div class="fld"><span>Accent</span><div class="swatches" id="swatches"></div></div>
      <div class="row">
        <label class="fld"><span>Theme</span>
          <select id="themeSel"><option value="light">Light</option><option value="dark">Dark</option></select>
        </label>
        <label class="fld"><span>Density</span>
          <select id="densitySel"><option value="compact">Compact</option><option value="normal">Normal</option><option value="comfortable">Comfortable</option></select>
        </label>
      </div>
      <div class="fld"><span>Projects</span>
        <div class="proj-list" id="projList"></div>
        <div class="proj-row" style="margin-top:8px">
          <input type="text" id="projName" placeholder="New project name" />
          <button id="projPick">Choose folder…</button>
        </div>
        <div id="projPathHint" style="font-size:11px;opacity:.5"></div>
        <label class="fld" id="projInstrWrap" style="margin-top:10px;display:none"><span id="projInstrLabel">Project instructions</span>
          <textarea id="projInstr" placeholder="Instructions appended to the system prompt for this project’s conversations…"></textarea>
        </label>
      </div>
      <div class="fld"><span>Same-WiFi link</span>
        <label class="lan-check"><input type="checkbox" id="lanServerChk" /> Act as server — let other devices route chats through this one</label>
        <div id="lanServerInfo" class="lan-info"></div>
        <div class="proj-row" style="margin-top:8px">
          <input type="text" id="lanHost" placeholder="host:port  (e.g. 192.168.1.5:47301)" />
          <button id="lanConnBtn" data-mode="conn">Connect</button>
        </div>
        <div id="lanClientInfo" class="lan-info"></div>
      </div>
    </div>
  </div>
</div>
<script src="app.js"></script>
</body>
</html>
