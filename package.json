{
  "name": "axon",
  "version": "0.7.25",
  "description": "Axon is a local-first Chat, Code, and Agent workspace powered by Ollama and Axon Terminal",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node src/selfcheck.js",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:deb": "electron-builder --linux deb",
    "publish:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_release.ps1",
    "publish:deb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_deb.ps1"
  },
  "build": {
    "appId": "io.axon.workspace",
    "productName": "Axon",
    "asar": true,
    "files": [
      "src/**",
      "!src/assets/axon-nervous-system-source.png",
      "!src/assets/icon-preview-64.png",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "extraResources": [
      {
        "from": "src/axon-browser-mcp.js",
        "to": "axon-browser-mcp.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "appImage": {
      "artifactName": "Axon-${version}.${ext}"
    },
    "deb": {
      "artifactName": "Axon_${version}_amd64.${ext}",
      "maintainer": "Axon contributors",
      "synopsis": "Local-first AI workspace",
      "description": "Axon is a local-first Chat, Code, and Work workspace powered by local models and its bundled Axon Terminal."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Axon-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3"
  }
}
