{
  "name": "nocli-ai",
  "version": "0.7.28",
  "author": {
    "name": "NoCLI.ai contributors",
    "email": "opensource@nocli.local"
  },
  "description": "NoCLI.ai is a local-first desktop workspace for models, tools, and official harnesses without living in a terminal.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node src/selfcheck.js",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:deb": "electron-builder --linux deb",
    "publish:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_release.ps1",
    "publish:deb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_deb.ps1"
  },
  "build": {
    "appId": "ai.nocli.desktop",
    "productName": "NoCLI.ai",
    "asar": true,
    "files": [
      "src/**",
      "!src/assets/nocli-mark.svg",
      "!src/assets/icon-preview-64.png",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "extraResources": [
      {
        "from": "src/nocli-browser-mcp.js",
        "to": "nocli-browser-mcp.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "appImage": {
      "artifactName": "nocli.ai-${version}.${ext}"
    },
    "deb": {
      "artifactName": "nocli.ai_${version}_amd64.${ext}",
      "maintainer": "NoCLI.ai contributors",
      "synopsis": "Local-first AI workspace",
      "description": "NoCLI.ai is a local-first desktop workspace for models, tools, and official harnesses without living in a terminal."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "nocli.ai-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3"
  }
}
