{
  "name": "axon",
  "version": "0.7.20",
  "description": "Axon is a local-first Chat, Code, and Agent workspace powered by Ollama and Axon Terminal",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node src/selfcheck.js",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "publish:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_release.ps1"
  },
  "build": {
    "appId": "io.axon.workspace",
    "productName": "Axon",
    "asar": true,
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "axon-terminal/codex-rs/target/release/axon.exe",
        "to": "axon-terminal/axon.exe"
      },
      {
        "from": "src/axon-browser-mcp.js",
        "to": "axon-browser-mcp.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "appImage": {
      "artifactName": "Axon-${version}.${ext}"
    },
    "deb": {
      "artifactName": "Axon_${version}_amd64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Axon-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3"
  }
}
